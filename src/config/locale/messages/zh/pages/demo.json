          {
            "title": "去分析",
            "url": "/analyze",
            "icon": "ScanSearch",
            "variant": "default"
          },
          {
            "title": "浏览 /apps",
            "url": "/apps",
            "icon": "Box",
            "variant": "outline"
          }
        ],
