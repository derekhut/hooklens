        "show_avatars": false,
        "image": {
          "src": "/imgs/hooklens/samples/feed.svg",
          "alt": "演示示例",
          "width": 390,
          "height": 844
        }
      },
      "media": {
        "block": "features-media",
        "id": "media",
        "title": "你应该看到什么",
        "description": "画布上的线框示例、成瘾区域上的琥珀色标注框，以及带摘要与发现列表的报告页。",
        "image": {
          "src": "/imgs/hooklens/samples/social.svg",
          "alt": "标注示例"
        }
      },
      "steps": {
        "block": "features-step",
        "id": "steps",
        "title": "演示脚本路径",
        "description": "给朋友和评委固定走这条路径。跳过任何需要安装的步骤。",
        "image": {
          "src": "/imgs/hooklens/samples/video.svg",
          "alt": "步骤"
        },
        "image_position": "left",
        "text_align": "center",
        "items": [
          {
            "title": "打开分析",
            "description": "进入 /analyze。在侧栏选择「无限信息流」或其他示例。",
            "image": {
              "src": "/imgs/hooklens/samples/feed.svg",
              "alt": "打开"
            }
          },
          {
            "title": "画 2–3 个框",
            "description": "标出滚动、红点或自动播放区域。设置钩子类型与一句话说明。",
            "image": {
              "src": "/imgs/hooklens/samples/social.svg",
              "alt": "画框"
            }
          },
          {
            "title": "生成报告",
            "description": "点击「生成 Report」。一起读摘要与发现列表。",
            "image": {
              "src": "/imgs/hooklens/samples/video.svg",
              "alt": "报告"
            }
          },
          {
            "title": "问一个问题",
            "description": "凌晨一点哪个钩子还会勾住你？可选打开 /apps 看更干净的替代。",
            "image": {
              "src": "/imgs/hooklens/samples/feed.svg",
              "alt": "提问"
            }
          }
        ],
        "className": "bg-muted"
      },
      "faq": {
        "id": "faq",
        "title": "演示常见问题",
        "items": [
          {
            "question": "报告页显示找不到——为什么？",
            "answer": "演示报告只存在本浏览器。请在同一设备重新生成，或继续走分析流程演示。"
          },
          {
            "question": "还需要 Chrome「加载已解压的扩展程序」吗？",
            "answer": "不需要。本演示完全是网页路径。"
          }
        ]
      },
      "cta": {
        "id": "cta",
        "title": "现在就跑一遍",
        "description": "在示例上标两个钩子并打开报告。",
